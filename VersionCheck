<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in — Lunex Plus</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0b0c11;
    --card: #15161d;
    --field: #1a1b23;
    --border: rgba(255,255,255,0.07);
    --border-focus: rgba(99,102,241,0.5);
    --ink: #f5f6f8;
    --dust: #8b8d98;
    --accent: #6366f1;
    --accent-soft: rgba(99,102,241,0.14);
    --accent-dark: #4338ca;
    --green: #34d399;
    --green-soft: rgba(52,211,153,0.14);
    --amber: #fbbf24;
    --amber-soft: rgba(251,191,36,0.14);
    --red: #f87171;
    --red-soft: rgba(248,113,113,0.14);
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: #000;
  }

  body {
    display: flex;
    justify-content: center;
    padding: 24px 0;
    min-height: 100vh;
    font-family: 'Inter', -apple-system, sans-serif;
  }

  .phone {
    width: 100%;
    max-width: 400px;
    background: var(--bg);
    min-height: 720px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 0 0 1px #1c1d24, 0 30px 70px rgba(0,0,0,0.6);
    display: flex;
    flex-direction: column;
  }

  .glow {
    position: absolute;
    width: 400px;
    height: 400px;
    top: -160px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(99,102,241,0.22) 0%, rgba(99,102,241,0) 70%);
    pointer-events: none;
  }

  .content {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px 28px 40px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 34px;
  }

  .mark {
    width: 76px;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    filter: drop-shadow(0 8px 20px rgba(99,102,241,0.45));
  }

  .mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.4px;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  h1 {
    font-size: 21px;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.2px;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px;
  }

  .field {
    margin-bottom: 16px;
  }

  .field:last-of-type { margin-bottom: 0; }

  label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--dust);
    margin-bottom: 7px;
    letter-spacing: 0.2px;
  }

  input {
    width: 100%;
    background: var(--field);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 14px;
    font-family: inherit;
    color: var(--ink);
    outline: none;
    transition: border-color 0.15s, background 0.15s;
  }

  input::placeholder { color: #55575f; }

  input:focus {
    border-color: var(--border-focus);
    background: #1e1f29;
  }

  .btn-signin {
    width: 100%;
    margin-top: 20px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 13px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
  }

  .btn-signin:hover { background: #5457e5; }
  .btn-signin:active { transform: scale(0.98); }

  .error {
    display: none;
    align-items: center;
    gap: 8px;
    background: var(--red-soft);
    border: 1px solid rgba(248,113,113,0.25);
    color: var(--red);
    font-size: 12.5px;
    font-weight: 500;
    border-radius: 9px;
    padding: 10px 12px;
    margin-top: 14px;
  }

  .error.show { display: flex; }
  .error svg { width: 15px; height: 15px; flex-shrink: 0; }

  .instructions {
    margin-top: 22px;
    background: var(--accent-soft);
    border: 1px solid rgba(99,102,241,0.22);
    border-radius: 12px;
    padding: 14px 15px;
    display: flex;
    gap: 10px;
  }

  .instructions svg {
    width: 17px;
    height: 17px;
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .instructions p {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.55;
    color: #c7c8f0;
  }

  .instructions p strong { color: var(--ink); }

  .footnote {
    text-align: center;
    font-size: 11.5px;
    color: var(--dust);
    margin-top: 22px;
  }
</style>
</head>
<body>

<div class="phone">
  <div class="glow"></div>
  <div class="content">

    <div class="brand">
      <div class="mark">
        <img src="data:image/png;base64," alt="Lunex Plus logo">
      </div>
      <div class="eyebrow">Lunex Plus</div>
      <h1>Sign in to continue</h1>
    </div>

    <div class="card">
      <div class="field">
        <label for="username">Username</label>
        <input type="text" id="username" placeholder="Enter your username" autocomplete="off">
      </div>
      <div class="field">
        <label for="password">Validation password</label>
        <input type="password" id="password" placeholder="Enter your validation password" autocomplete="off">
      </div>

      <button class="btn-signin" id="signinBtn">Sign in</button>

      <div class="error" id="errorMsg">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v5"/><path d="M12 16h.01"/></svg>
        <span>Incorrect username or validation password.</span>
      </div>
    </div>

    <div class="instructions">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      <p><strong>Don't have a validation password?</strong> Go to <strong>#🤖・commands</strong> and use <strong>/request-validation-password</strong>. This password is issued per device, so if you switch devices you need to request it again.</p>
    </div>

    <div class="footnote">Lunex · Version 1.5 BETA</div>

  </div>
</div>

<script>
  // Wire this up to your own auth check — swap CREDENTIALS for a real
  // lookup (server call, local config, etc). This is just a UI shell;
  // it does not ship with a real validation password baked in.
  const CREDENTIALS = {
    // username: "validation_password"
  };

  const usernameEl = document.getElementById('username');
  const passwordEl = document.getElementById('password');
  const errorEl = document.getElementById('errorMsg');
  const btn = document.getElementById('signinBtn');

  function attemptSignIn() {
    const user = usernameEl.value.trim();
    const pass = passwordEl.value;
    errorEl.classList.remove('show');

    if (!user || !pass) {
      errorEl.querySelector('span').textContent = 'Enter both a username and a validation password.';
      errorEl.classList.add('show');
      return;
    }

    if (CREDENTIALS[user] && CREDENTIALS[user] === pass) {
      // Success path — replace with your real post-login behavior.
      alert('Signed in as ' + user);
    } else {
      errorEl.querySelector('span').textContent = 'Incorrect username or validation password.';
      errorEl.classList.add('show');
    }
  }

  btn.addEventListener('click', attemptSignIn);
  passwordEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') attemptSignIn(); });
</script>

</body>
</html>
